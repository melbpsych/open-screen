{
  "name": "open-screen",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 serve.py",
    "test": "node --test *.test.mjs core/*.test.mjs gates/*.test.mjs && node core/compile.js --check && python3 ports/test_score.py && python3 -m unittest test_serve.py",
    "compile": "node core/compile.js",
    "typecheck": "tsc -p tsconfig.json",
    "check:config": "node scripts/check-config.js",
    "check": "npm run check:config && npm run typecheck && npm test",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test:e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  },
  "version": "0.3.0",
  "description": "Local, configurable adult screening workflows and a dependency-free integration API.",
  "exports": {
    ".": {
      "types": "./api.d.ts",
      "import": "./api.js"
    },
    "./policy": {
      "types": "./policy.d.ts",
      "import": "./policy.js"
    },
    "./presentation": {
      "types": "./presentation.d.ts",
      "import": "./presentation.js"
    },
    "./personality": "./core/score.js",
    "./questionnaires": {
      "types": "./questionnaires/registry.d.ts",
      "import": "./questionnaires/registry.js"
    }
  },
  "files": [
    "api.js",
    "api.d.ts",
    "policy.js",
    "policy.d.ts",
    "presentation.js",
    "presentation.d.ts",
    "core/*.js",
    "gates/*.js",
    "measures/*.json",
    "questionnaires/*.js",
    "questionnaires/*.d.ts",
    "questionnaires/*.json",
    "config/policy.json",
    "examples/*",
    "docs/*.md",
    "docs/sources/*"
  ]
}
